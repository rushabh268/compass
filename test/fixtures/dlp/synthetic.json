  "negativeExamples": [
    {
      "name": "function call getToken",
      "text": "const token = getToken()",
      "should": "not detect (function call, not assignment value)"
    },
    {
      "name": "comparison with secret",
      "text": "if (secret === expectedValue) { }",
      "should": "not detect (comparison operator, not assignment value)"
    },
    {
      "name": "environment variable reference",
      "text": "apiKey = process.env.SENSITIVE_KEY",
      "should": "not detect (env reference, not literal value)"
    },
    {
      "name": "parameter maxToken",
      "text": "config({ maxToken: 4096 })",
      "should": "not detect (numeric parameter, not credential)"
    },
    {
      "name": "cancellationToken parameter",
      "text": "async function doWork(cancellationToken=signal) { }",
      "should": "not detect (parameter declaration, not credential assignment)"
    },
     {
       "name": "token_type field",
       "text": "response: { token_type: 'Bearer' }",
       "should": "not detect token_type (excluded by drift guard)"
     }
  ],
  "credentialKeyDriftGuard": {
    "accepted": [
      "secretKey",
      "privateKey",
      "signingKey",
      "encryptionKey",
      "sessionKey",
      "database_secret_key",
      "SERVICE-SIGNING-KEY"
    ],
    "rejected": [
      "clientPasswordHash",
      "client_password_hash",
      "token_type",
      "tokenType",
      "publicKey",
      "monkey"
    ]
  },
  "safeExamples": [
    "token=${TOKEN}",
